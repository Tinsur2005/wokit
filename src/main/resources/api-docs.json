          "auth": "Bearer Token",
          "permission": "weekly:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "周报 ID"}],
          "body": {"weekStart": "2026-11-23", "weekEnd": "2026-11-29", "taskTitle": "完成接口联调", "taskContent": "完成登录与任务接口", "taskResult": "联调通过", "projectId": null},
          "response": {"code": 1, "msg": "修改成功", "data": null}
        },
        {
          "method": "DELETE",
          "path": "/weeklies/{id}",
          "summary": "删除周报",
          "auth": "Bearer Token",
          "permission": "weekly:delete",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "周报 ID"}],
          "response": {"code": 1, "msg": "删除成功", "data": null}
        }
      ]
    },
