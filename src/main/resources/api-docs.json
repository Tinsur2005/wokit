      ]
    },
    {
      "name": "计时",
      "key": "timers",
      "description": "计时模式：countdown_day 倒数日、countup_day 正数日、precise 精准倒计时。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/timers",
          "summary": "查询计时列表",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "response": {"code": 1, "data": [{"id": 1, "name": "项目上线", "mode": "countdown_day", "targetTime": "2026-12-01 00:00:00"}]}
        },
        {
          "method": "POST",
          "path": "/timers",
          "summary": "新增计时",
          "auth": "Bearer Token",
          "permission": "timer:add",
          "body": {"name": "项目上线", "mode": "countdown_day", "targetTime": "2026-12-01 00:00:00"},
          "response": {"code": 1, "msg": "新增成功", "data": null}
        },
        {
          "method": "PUT",
          "path": "/timers/{id}",
          "summary": "修改计时",
          "auth": "Bearer Token",
          "permission": "timer:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "计时 ID"}],
          "body": {"name": "项目上线", "mode": "precise", "targetTime": "2026-12-01 09:00:00"},
          "response": {"code": 1, "msg": "修改成功", "data": null}
        },
        {
          "method": "DELETE",
          "path": "/timers/{id}",
          "summary": "删除计时",
          "auth": "Bearer Token",
          "permission": "timer:delete",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "计时 ID"}],
          "response": {"code": 1, "msg": "删除成功", "data": null}
        }
      ]
    },
    {
      "name": "项目",
      "key": "projects",
      "description": "项目按创建时间倒序。状态：0 规划中、1 进行中、2 维护中、3 暂停、4 已完成、5 已取消。归档是独立字段，不是状态；archived=true 查询已归档项目。taskOpen 和 taskTotal 实时统计 taskKind=1 的项目任务，不存冗余计数字段。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/projects",
          "summary": "查询项目列表",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "query": [
            {"name": "categoryId", "type": "long", "required": false, "description": "分类 ID"},
            {"name": "keyword", "type": "string", "required": false, "description": "项目名称关键字"},
            {"name": "status", "type": "int", "required": false, "description": "项目状态"},
            {"name": "archived", "type": "boolean", "required": false, "description": "true 查询已归档；默认 false 查询当前项目"}
          ],
          "response": {"code": 1, "data": [{"id": 1, "name": "Wokit 工作助手", "categoryId": 1, "categoryName": "个人项目", "status": 2, "statusName": "维护中", "archived": false, "taskTotal": 12, "taskOpen": 5, "taskDone": 7}]}
        },
        {
          "method": "POST",
          "path": "/projects",
          "summary": "新增项目",
          "auth": "Bearer Token",
          "permission": "project:add",
          "body": {"name": "Wokit 工作助手", "categoryId": 1},
          "response": {"code": 1, "msg": "新增成功", "data": null}
        },
        {
          "method": "PUT",
          "path": "/projects/{id}",
          "summary": "修改项目",
          "auth": "Bearer Token",
          "permission": "project:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "项目 ID"}],
          "body": {"name": "Wokit 工作助手", "categoryId": 1, "status": 2},
          "response": {"code": 1, "msg": "修改成功", "data": null},
          "notes": "编辑项目时可以同时修改业务状态；已归档项目必须先恢复才能编辑。"
        },
        {
          "method": "PUT",
          "path": "/projects/status/{id}",
          "summary": "修改项目状态",
          "auth": "Bearer Token",
          "permission": "project:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "项目 ID"}],
          "query": [{"name": "status", "type": "int", "required": true, "description": "0 规划中 / 1 进行中 / 2 维护中 / 3 暂停 / 4 已完成 / 5 已取消"}],
          "response": {"code": 1, "msg": "项目状态已更新为「维护中」", "data": null},
          "notes": "维护中表示项目已经发布但未结束，可以继续新增项目任务。已归档项目必须先恢复才能改状态。"
        },
        {
          "method": "PUT",
          "path": "/projects/archive/{id}",
          "summary": "归档项目",
          "auth": "Bearer Token",
          "permission": "project:archive",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "项目 ID"}],
          "query": [{"name": "reason", "type": "string", "required": false, "description": "归档原因，最多 200 字"}],
          "response": {"code": 1, "msg": "项目已归档", "data": null},
          "notes": "归档后项目只读，不能编辑、改状态或新增项目任务，可以恢复。"
        },
        {
          "method": "PUT",
          "path": "/projects/restore/{id}",
          "summary": "恢复已归档项目",
          "auth": "Bearer Token",
          "permission": "project:restore",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "项目 ID"}],
          "response": {"code": 1, "msg": "项目已恢复", "data": null},
          "notes": "恢复到归档前的业务状态。"
        },
        {
          "method": "DELETE",
          "path": "/projects/{id}",
          "summary": "删除项目",
          "auth": "Bearer Token",
          "permission": "project:delete",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "项目 ID"}],
          "response": {"code": 1, "msg": "删除成功", "data": null},
          "notes": "存在任务、周报或工时时禁止删除，只能归档。"
        }
      ]
    },
    {
      "name": "项目分类",
      "key": "project-categories",
      "description": "项目分类支持父子层级，parentId 为空表示一级分类。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/project-categories",
          "summary": "查询项目分类",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "response": {"code": 1, "data": [{"id": 1, "parentId": null, "name": "个人项目", "children": []}]}
        },
        {
          "method": "POST",
          "path": "/project-categories",
          "summary": "新增项目分类",
          "auth": "Bearer Token",
          "permission": "project:category:add",
          "body": {"name": "个人项目", "parentId": null},
          "response": {"code": 1, "msg": "新增成功", "data": null}
        },
        {
          "method": "PUT",
          "path": "/project-categories/{id}",
          "summary": "修改项目分类",
          "auth": "Bearer Token",
          "permission": "project:category:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "分类 ID"}],
          "body": {"name": "个人项目", "parentId": null},
          "response": {"code": 1, "msg": "修改成功", "data": null}
        },
        {
          "method": "DELETE",
          "path": "/project-categories/{id}",
          "summary": "删除项目分类",
          "auth": "Bearer Token",
          "permission": "project:category:delete",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "分类 ID"}],
          "response": {"code": 1, "msg": "删除成功", "data": null}
        }
      ]
    }
  ]
}
