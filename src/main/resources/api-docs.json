          "response": {"code": 1, "data": [{"id": 1, "weekStart": "2026-11-23", "weekEnd": "2026-11-29", "taskTitle": "完成接口联调", "taskContent": "完成登录与任务接口", "taskResult": "联调通过", "projectId": null}]}
