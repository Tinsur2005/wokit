{
  "title": "Wokit 开放 API",
  "version": "1.0.0",
  "baseUrl": "/api/v1",
  "updatedAt": "2026-11-26",
  "overview": "Wokit 开放 API 面向桌面端、手机 App 和可信服务端。App 只允许登录，不提供注册接口；用户账号由管理员在网页端「用户管理」中创建。",
  "authRules": [
    "App 登录：请求头携带 X-Wokit-Client-Key（Access Key），请求体携带用户账号和密码。Secret Key 不进入 App 安装包。",
    "业务接口：请求头携带 Authorization: Bearer <accessToken>，Token 中的 userId 决定数据归属。",
    "服务端对接：使用 Access Key / Secret Key 调用 /oauth/token 获取 Service Token，Secret 只保存在服务器环境变量或密钥管理系统中。",
    "App 没有 /auth/register 接口，任何自助注册请求都不会被受理。",
    "用户 Token 有效期 1 小时；Refresh Token 有效期 30 天，每次刷新都会轮换，旧 Refresh Token 立即失效。",
    "所有业务接口只返回当前 Token 对应用户的数据，不接受请求体传 userId。"
  ],
  "httpRules": [
    "成功：HTTP 200，响应体 code = 1。",
    "参数错误：HTTP 400。",
    "未登录、Token 失效、密钥无效：HTTP 401。",
    "账号停用、权限不足、IP 不在白名单：HTTP 403。",
    "登录失败次数过多：HTTP 429。",
    "业务校验失败：HTTP 200，响应体 code = 0，msg 为具体原因。"
  ],
  "groups": [
    {
      "name": "认证与账号",
      "key": "auth",
      "description": "App 登录、Token 刷新、退出、当前用户、修改密码，以及服务端 Client Credentials。App 不提供注册接口，账号只能由管理员在网页端用户管理中创建。",
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/login",
          "summary": "App 用户登录",
          "auth": "Access Key + 用户账号密码",
          "permission": "应用 Key 必须为启用状态；用户必须由管理员创建且处于启用状态",
          "headers": [
            {"name": "X-Wokit-Client-Key", "value": "wk_ak_xxx", "description": "API Key 页面创建的 Access Key"}
          ],
          "body": {
            "username": "demo",
            "password": "123456",
            "deviceId": "desktop-01",
            "deviceName": "演示设备"
          },
          "response": {
            "code": 1,
            "msg": "登录成功",
            "data": {
              "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
              "refreshToken": "wk_rt_xxx",
              "tokenType": "Bearer",
              "expiresIn": 3600,
              "user": {
                "id": 2,
                "name": "demo",
                "realName": "演示用户",
                "avatar": null,
                "role": 0,
                "roleName": "普通用户"
              }
            }
          },
          "notes": "Secret Key 不需要参与 App 登录。Access Key 是公开的应用标识，被停用后登录立即失败。"
        },
        {
          "method": "POST",
          "path": "/auth/refresh",
          "summary": "刷新用户 Token",
          "auth": "无需 Authorization；请求体携带 refreshToken",
          "permission": "Refresh Token 未撤销、未过期；应用 Key 仍启用；用户仍启用",
          "body": {
            "refreshToken": "wk_rt_xxx",
            "deviceId": "desktop-01",
            "deviceName": "演示设备"
          },
          "response": {
            "code": 1,
            "msg": "刷新成功",
            "data": {
              "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
              "refreshToken": "wk_rt_yyy",
              "tokenType": "Bearer",
              "expiresIn": 3600,
              "user": {"id": 2, "name": "demo", "realName": "演示用户", "role": 0, "roleName": "普通用户"}
            }
          },
          "notes": "Refresh Token 使用一次后立即失效，客户端必须保存返回的新 refreshToken。"
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "summary": "退出登录",
          "auth": "无需 Authorization；请求体携带 refreshToken",
          "permission": "无",
          "body": {"refreshToken": "wk_rt_xxx"},
          "response": {"code": 1, "msg": "已退出登录", "data": null},
          "notes": "退出只撤销 Refresh Token，已经签发的 Access Token 最长 1 小时后自然过期。"
        },
        {
          "method": "GET",
          "path": "/me",
          "summary": "当前用户信息与权限",
          "auth": "Bearer User Token 或 Service Token",
          "permission": "有效 Token",
          "response": {
            "code": 1,
            "msg": null,
            "data": {
              "user": {"id": 2, "name": "demo", "realName": "演示用户", "role": 0, "roleName": "普通用户"},
              "routerList": [],
              "btnList": ["task:add", "task:edit"]
            }
          },
          "notes": "App 可以用 btnList 控制按钮显隐；数据接口仍由服务端再次校验权限。"
        },
        {
          "method": "PUT",
          "path": "/me/password",
          "summary": "修改当前用户密码",
          "auth": "Bearer User Token",
          "permission": "仅用户 Token，Service Token 不允许调用",
          "body": {"oldPassword": "123456", "newPassword": "654321"},
          "response": {"code": 1, "msg": "密码修改成功，请重新登录", "data": null},
          "notes": "修改成功后服务端撤销该用户全部 Refresh Token，App 应清除本地登录状态。"
        },
        {
          "method": "POST",
          "path": "/oauth/token",
          "summary": "服务端 Client Credentials 换取 Service Token",
          "auth": "Access Key + Secret Key",
          "permission": "仅 service 类型的 API Key；Key 所属用户必须有 API Key 访问权限",
          "contentType": "application/x-www-form-urlencoded",
          "body": {
            "grant_type": "client_credentials",
            "client_id": "wk_ak_xxx",
            "client_secret": "wk_sk_xxx"
          },
          "response": {
            "code": 1,
            "msg": "获取成功",
            "data": {
              "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
              "tokenType": "Bearer",
              "expiresIn": 3600,
              "scope": "data:read,data:write",
              "apiKeyId": 1
            }
          },
          "notes": "Service Token 的数据归属为 Key 所属用户。Secret 只应在服务端保存，禁止写入桌面端或手机 App 安装包。"
        }
      ]
    },
    {
      "name": "首页看板",
      "key": "dashboard",
      "description": "工作台首页的汇总数据。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/dashboard",
          "summary": "获取首页看板数据",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "query": [
            {"name": "weekOffset", "type": "int", "required": false, "description": "任务趋势查看周偏移：0 本周、-1 上周，依此类推；不允许未来周"}
          ],
          "response": {
            "code": 1,
            "data": {
              "taskStat": {"total": 8, "pending": 3, "doing": 2, "done": 3},
              "todayHours": 6.5,
              "weeklyCount": 3,
              "trend": [],
              "projectHours": [],
              "weeklyTrend": []
            }
          },
          "notes": "taskTrend 返回指定周周一至周日 7 天数据，每天包含 created 新增、total 当日任务总数、completed 当日完成；projectHours 为本周工时分布；其他统计仍按当前时间口径。"
        }
      ]
    },
    {
      "name": "每日任务",
      "key": "tasks",
      "description": "任务类型：0 普通任务、1 项目任务；普通任务不关联项目；项目任务必须传 projectId 和 taskCategoryId。任务类型、绑定项目和分类创建后不可修改。状态：0 待处理、1 进行中、2 阻塞中、3 已完成；优先级：0 紧急、1 重要、2 普通、3 低优先级。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/tasks",
          "summary": "分页查询任务",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "query": [
            {"name": "page", "type": "int", "required": false, "description": "页码，默认 1"},
            {"name": "limit", "type": "int", "required": false, "description": "每页数量，默认 10"},
            {"name": "keyword", "type": "string", "required": false, "description": "标题/描述关键字"},
            {"name": "status", "type": "int", "required": false, "description": "任务状态"},
            {"name": "date", "type": "string", "required": false, "description": "日期，格式 yyyy-MM-dd"},
            {"name": "taskKind", "type": "int", "required": false, "description": "任务类型：0 普通任务 / 1 项目任务"},
            {"name": "projectId", "type": "long", "required": false, "description": "项目 ID，仅项目任务"},
            {"name": "taskCategoryId", "type": "long", "required": false, "description": "任务分类 ID，仅项目任务"}
          ],
          "response": {
            "code": 1,
            "data": {
              "records": [
                {"id": 1, "title": "完成接口联调", "description": "验证登录与任务接口", "priority": 1, "status": 1, "startTime": "2026-11-26 09:30:00", "deadline": "2026-11-26 11:00:00", "taskKind": 1, "projectId": 2, "taskCategoryId": 1, "completedAt": null}
              ],
              "total": 1, "size": 10, "current": 1, "pages": 1
            }
          }
        },
        {
          "method": "GET",
          "path": "/tasks/date",
          "summary": "查询某一天的任务",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "query": [{"name": "date", "type": "string", "required": true, "description": "yyyy-MM-dd"}],
          "response": {"code": 1, "data": [{"id": 1, "title": "完成接口联调", "status": 1, "priority": 1}]}
        },
        {
          "method": "GET",
          "path": "/tasks/calendar",
          "summary": "查询某月日历任务标记",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "query": [{"name": "month", "type": "string", "required": true, "description": "yyyy-MM"}],
          "response": {"code": 1, "data": [{"date": "2026-11-26", "count": 3, "allDone": false}]}
        },
        {
          "method": "GET",
          "path": "/tasks/stat",
          "summary": "任务统计卡片",
          "auth": "Bearer Token",
          "permission": "有效 Token",
          "response": {"code": 1, "data": {"todayPending": 1, "todayTotal": 3, "weekCompleted": 2, "weekTotal": 5, "monthTotal": 3, "monthCompleted": 1}}
        },
        {
          "method": "GET",
          "path": "/tasks/{id}",
          "summary": "任务详情",
          "auth": "Bearer Token",
          "permission": "有效 Token，且任务属于当前用户",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "任务 ID"}],
          "response": {"code": 1, "data": {"id": 1, "title": "完成接口联调", "priority": 1, "status": 1}}
        },
        {
          "method": "POST",
          "path": "/tasks",
          "summary": "新增任务",
          "auth": "Bearer Token",
          "permission": "task:add",
          "body": {
            "title": "完成接口联调",
            "description": "验证登录与任务接口",
            "priority": 1,
            "startTime": "2026-11-26 09:30:00",
            "deadline": "2026-11-26 11:00:00",
            "taskKind": 0,
            "projectId": null,
            "taskCategoryId": null
          },
          "response": {"code": 1, "msg": "新增成功", "data": null},
          "notes": "任务类型不传时默认普通任务。兼容旧调用：只传 projectId、不传 taskKind 时按项目任务处理，并自动取「其他」分类。"
        },
        {
          "method": "PUT",
          "path": "/tasks/{id}",
          "summary": "修改任务",
          "auth": "Bearer Token",
          "permission": "task:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "任务 ID"}],
          "body": {"title": "完成接口联调", "description": "补充移动端", "priority": 0, "startTime": "2026-11-26 09:30:00", "deadline": "2026-11-26 12:00:00", "taskKind": 1, "projectId": 2, "taskCategoryId": 1},
          "response": {"code": 1, "msg": "修改成功", "data": null},
          "notes": "taskKind、projectId、taskCategoryId 创建后不可修改；传入不同值会返回业务校验失败。"
        },
        {
          "method": "PUT",
          "path": "/tasks/status/{id}",
          "summary": "修改任务状态",
          "auth": "Bearer Token",
          "permission": "task:toggle",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "任务 ID"}],
          "query": [{"name": "status", "type": "int", "required": true, "description": "0 待处理 / 1 进行中 / 2 阻塞中 / 3 已完成"}],
          "response": {"code": 1, "msg": "任务状态已更新", "data": null}
        },
        {
          "method": "PUT",
          "path": "/tasks/priority/{id}",
          "summary": "修改任务优先级",
          "auth": "Bearer Token",
          "permission": "task:edit",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "任务 ID"}],
          "query": [{"name": "priority", "type": "int", "required": true, "description": "0 紧急 / 1 重要 / 2 普通 / 3 低优先级"}],
          "response": {"code": 1, "msg": "优先级已更新", "data": null}
        },
        {
          "method": "DELETE",
          "path": "/tasks/{id}",
          "summary": "删除任务",
          "auth": "Bearer Token",
          "permission": "task:delete",
          "params": [{"name": "id", "in": "path", "type": "long", "required": true, "description": "任务 ID"}],
          "response": {"code": 1, "msg": "删除成功", "data": null}
        }
      ]
    },
    {
      "name": "任务分类",
      "key": "task-categories",
      "description": "项目任务分类由管理员在网页端「系统设置 / 任务分类」统一维护。已被任务使用的分类只能修改，未被使用的分类可以删除。",
      "endpoints": [
        {
          "method": "GET",
          "path": "/task-categories",
          "summary": "查询任务分类",
          "auth": "Bearer Token",
          "permission": "有效 Token",
